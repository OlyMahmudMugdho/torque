%%
%% fontspec.sty
%%
%% Client-Side WebAssembly compatible fontspec package for Torque
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fontspec}[2024/01/01 v2.9 Torque compatible fontspec]

\RequirePackage{iftex}

% Font feature controls
\DeclareDocumentCommand\defaultfontfeatures{ t+ o m o }{}
\DeclareDocumentCommand\addfontfeatures{ m }{}
\DeclareDocumentCommand\newfontfeature{ m m }{}
\DeclareDocumentCommand\aliasfontfeature{ m m }{}
\DeclareDocumentCommand\aliasfontfeatureoption{ m m m }{}

% Main font setters (handles both [options]{font} and {font}[options])
\DeclareDocumentCommand\setmainfont{ o m o }{}
\DeclareDocumentCommand\setsansfont{ o m o }{}
\DeclareDocumentCommand\setmonofont{ o m o }{}
\DeclareDocumentCommand\setromanfont{ o m o }{}

% New font family declarations (\newfontfamily\cmd[options]{font}[options])
\DeclareDocumentCommand\newfontfamily{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\setfontfamily{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\renewfontfamily{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\providefontfamily{ m o m o }{\providecommand#1{}}

% Face declarations
\DeclareDocumentCommand\newfontface{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\setfontface{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\renewfontface{ m o m o }{\providecommand#1{}}
\DeclareDocumentCommand\providefontface{ m o m o }{\providecommand#1{}}

% In-line font specification
\DeclareDocumentCommand\fontspec{ o m o }{}
\DeclareDocumentCommand\addfontfeature{ m }{}

\endinput
